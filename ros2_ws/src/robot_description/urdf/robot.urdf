<?xml version="1.0" encoding="utf-8"?>
<robot name="frob" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============ ПАРАМЕТРЫ РОБОТА ============ -->
    
    <!-- Колёса -->
    <xacro:property name="wheel_radius" value="0.02"/>      <!-- Радиус = диаметр/2 = 0.04/2 -->
    <xacro:property name="wheel_width" value="0.02"/>       <!-- Толщина колеса -->
    <xacro:property name="wheel_separation" value="0.0975"/> <!-- База между колёсами -->
    
    <!-- Корпус -->
    <xacro:property name="body_length" value="0.1"/>        <!-- Длина (X) -->
    <xacro:property name="body_width" value="0.09"/>        <!-- Ширина (Y) -->
    <xacro:property name="body_height" value="0.01"/>       <!-- Высота корпуса -->
    
    <!-- Клиренс -->
    <xacro:property name="clearance" value="0.014"/>        <!-- Дорожный просвет -->
    
    <!-- Лидар -->
    <xacro:property name="laser_height" value="0.16"/>      <!-- Высота лидара над полом -->
    <xacro:property name="laser_size" value="0.04"/>        <!-- Диаметр корпуса лидара -->
    
    <!-- Массы (для симуляции) -->
    <xacro:property name="body_mass" value="1.5"/>
    <xacro:property name="wheel_mass" value="0.1"/>
    
    <!-- Константы -->
    <xacro:property name="PI" value="3.1415926536"/>

    <!-- ============ МАКРОСЫ ============ -->
    
    <!-- Макрос для инерции цилиндра -->
    <xacro:macro name="cylinder_inertia" params="mass radius length">
        <inertial>
            <mass value="${mass}"/>
            <inertia 
                ixx="${mass * (3*radius*radius + length*length) / 12}" 
                ixy="0.0" ixz="0.0"
                iyy="${mass * (3*radius*radius + length*length) / 12}" 
                iyz="0.0"
                izz="${mass * radius*radius / 2}"/>
        </inertial>
    </xacro:macro>
    
    <!-- Макрос для инерции прямоугольника -->
    <xacro:macro name="box_inertia" params="mass x y z">
        <inertial>
            <mass value="${mass}"/>
            <inertia 
                ixx="${mass * (y*y + z*z) / 12}" 
                ixy="0.0" ixz="0.0"
                iyy="${mass * (x*x + z*z) / 12}" 
                iyz="0.0"
                izz="${mass * (x*x + y*y) / 12}"/>
        </inertial>
    </xacro:macro>

    <!-- ============ ЛИНКИ ============ -->
    
    <!-- Base footprint - виртуальная точка на полу -->
    <link name="base_footprint">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
        </visual>
    </link>

    <!-- Base link - основной корпус -->
    <link name="base_link">
        <xacro:box_inertia mass="${body_mass}" 
                          x="${body_length}" 
                          y="${body_width}" 
                          z="${body_height}"/>
        
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>
    </link>

    <!-- Левое колесо -->
    <link name="left_wheel">
        <xacro:cylinder_inertia mass="${wheel_mass}" 
                               radius="${wheel_radius}" 
                               length="${wheel_width}"/>
        
        <visual>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
    </link>

    <!-- Правое колесо -->
    <link name="right_wheel">
        <xacro:cylinder_inertia mass="${wheel_mass}" 
                               radius="${wheel_radius}" 
                               length="${wheel_width}"/>
        
        <visual>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
    </link>

    <!-- Лидар (визуальный корпус) -->
    <link name="lidar">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${laser_size/2}" length="0.025"/>
            </geometry>
            <material name="yellow">
                <color rgba="1 1 0 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${laser_size/2}" length="0.025"/>
            </geometry>
        </collision>
    </link>

    <!-- Laser - фрейм сканирования -->
    <link name="laser"/>

    <!-- ============ ДЖОИНТЫ ============ -->
    
    <!-- Footprint → Base link -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${clearance + body_height/2}" rpy="0 0 0"/>
    </joint>

    <!-- Base link → Левое колесо -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 ${wheel_separation/2} ${wheel_radius - clearance - body_height/2}" 
                rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Base link → Правое колесо -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 ${-wheel_separation/2} ${wheel_radius - clearance - body_height/2}" 
                rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- Base link → Lidar (визуальный корпус) -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin xyz="0 0 ${laser_height - clearance - body_height/2}" rpy="0 0 0"/>
    </joint>

    <!-- Lidar → Laser (фрейм сканирования) -->
    <joint name="laser_joint" type="fixed">
        <parent link="lidar"/>
        <child link="laser"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>
